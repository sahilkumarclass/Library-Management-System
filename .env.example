# -----------------------------------------------------------------------------
# Library Management System — environment variables
# Copy this file to `.env` (or export these vars in your shell) and fill in
# real values. Never commit your real .env.
# -----------------------------------------------------------------------------

# Neon PostgreSQL JDBC URL.
# IMPORTANT: Neon's copy-pasted string starts with `postgresql://` — prepend
# `jdbc:` for Spring Boot. Keep `?sslmode=require` — Neon requires SSL.
DB_URL=jdbc:postgresql://<your-neon-host>/<your-db>?sslmode=require
DB_USER=<your-neon-role>
DB_PASSWORD=<your-neon-password>

# JWT signing secret. Must be at least 32 characters (HS256).
# Generate with: `openssl rand -base64 48`
JWT_SECRET=replace_me_with_a_long_random_base64_string
